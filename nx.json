{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "maxCacheSize": "5GB",
  "parallel": 2,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.mjs",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/eslint.config.*",
      "!{projectRoot}/.prettierrc*",
      "!{projectRoot}/jest.config.*",
      "!{projectRoot}/README.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.nvmrc"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.prettierrc"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", "{workspaceRoot}/scripts/check-dropdown-preloads.sh"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "start:dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "start:prod": {
      "dependsOn": ["^build"],
      "cache": false
    }
  },
  "analytics": false
}
